    {
      "id": "5fe18640-bd87-45ea-b650-4c5ad4878cc4",
      "block_id": "ed55ac19-356e-4243-a6cb-bc599e9b716f",
      "input_default": {
        "model": "gpt-5.6-terra",
        "retry": 3,
        "prompt": "You are an elite front-end engineer and designer. Build the finished {{kind}} as ONE complete self-contained HTML file (inline CSS and JS only). Language: {{lang}}. Style: {{style}}. Contact: {{contact}}.\n\nHARD RULES:\n- Mobile first, responsive, accessible, good contrast, tap targets at least 44px. Include meta viewport, title and meta description. If the language is Arabic use <html lang=\"ar\" dir=\"rtl\">.\n- Sticky header with a working JS hamburger menu on mobile. Smooth navigation between every page in the site map using sections or hash routing.\n- NO external images, fonts or libraries. Use CSS gradients, inline SVG and emoji only. No placeholder image URLs.\n- NO fake testimonials, customer names, statistics, prices or claims. Where real data is missing, use neutral wording or a clear editable placeholder.\n- Footer year must be dynamic: <span id=\"y\"></span> filled by new Date().getFullYear().\n- Include a working booking/lead form (name, phone, message) that needs no backend: build a wa.me link (or mailto if only an email is given) from the form values and open it; show a thank-you message after submit. Use tel:, wa.me and mailto links for contact details and a floating WhatsApp button when a number is given.\n- If relevant, working cart/booking UI in plain JS (state in memory only).\n- FAQ with details/summary.\n\nPLAN:\n{{plan}}\n\nDESIGN SYSTEM:\n{{design_system}}\n\nCOPY:\n{{page_copy}}\n\nReturn only the HTML in 'html' and a short title in 'title'.",
        "list_result": false,
        "ollama_host": "localhost:11434",
        "prompt_values": {},
        "expected_format": {
          "html": "Complete HTML document",
          "title": "Site title"
        },
        "force_json_output": false,
        "compress_prompt_to_fit": true
      },
